# Copy to web/.env for local development (never commit .env).

# Login password as an scrypt hash: run `npm run hash-password` and paste the
# printed value. Leave empty locally to skip login (the server then listens on
# 127.0.0.1 only). On Cloudflare it is required, set as a Worker secret.
APP_PASSWORD_HASH=

# Optional: a separate random key for signing session cookies. Without it the
# key is derived from APP_PASSWORD_HASH.
SESSION_SECRET=

# Optional local server settings
PORT=3000
# HOST=127.0.0.1

# MongoDB. Leave empty locally to use the Docker Compose database
# (`npm run db:up`, at mongodb://127.0.0.1:27018). On Cloudflare set it as a
# Worker secret (the Atlas connection string).
MONGODB_URI=
# MONGODB_DB=codedrills

# Judge. Leave empty locally to use the Docker judge (`npm run db:up`). To use
# the AWS judge (and on Cloudflare, as secrets): the function's Invoke URL,
#   https://lambda.ap-south-1.amazonaws.com/2015-03-31/functions/codedrills-judge/invocations
# plus the keys of the IAM user that may only invoke it, and its region.
# See judge/aws/SETUP.md.
JUDGE_URL=
JUDGE_AWS_ACCESS_KEY_ID=
JUDGE_AWS_SECRET_ACCESS_KEY=
# JUDGE_AWS_REGION=ap-south-1
